# Coil Production .env.example
# Copy this to .env and edit as needed. Never commit real secrets.

# REQUIRED - Strong random secret (generated automatically by install.sh)
SECRET_KEY=change-this-to-a-very-long-random-string-at-least-64-characters

# Base URL - MUST be the public HTTPS address users will visit
BASE_URL=https://coil.yourfirm.com

# Database (SQLite is fine for most solo/small firms)
DATABASE_URL=sqlite:////app/data/practice.db

# Email (required for invoices, engagements, reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# Optional: Stripe for online payments
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Twilio for SMS (voice intake, reminders)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# Optional: AI features (Anthropic or OpenRouter)
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=...

# Optional: CourtListener research token
COURTLISTENER_TOKEN=...

# Advanced
COIL_SKIP_INSTALL_KEY=0
AI_DAILY_CAP_CENTS=500
LLM_DAILY_CAP=0
